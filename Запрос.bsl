МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.УстановитьПараметр("ТоварнаяКатегория",    ПараметрыЗапроса.ТоварнаяКатегория);
	Запрос.УстановитьПараметр("СкладРЦ",              ПараметрыЗапроса.СкладРЦ);
	Запрос.УстановитьПараметр("ДатаНачалаПериода",   ПараметрыЗапроса.ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", ПараметрыЗапроса.ДатаОкончанияПериода);
	
	Если ПараметрыЗапроса.Свойство("СписокГМ") Тогда
		Запрос.УстановитьПараметр("СписокГМ", ПараметрыЗапроса.СписокГМ);
	Иначе
		Запрос.УстановитьПараметр("СписокГМ", Неопределено);
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Склад,
	|	Склады.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВТ_РозничныеСклады
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.РозничныйМагазин)
	|	И НЕ Склады.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоШтучныйТовар
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ТоварнаяКатегория = &ТоварнаяКатегория
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ТоварыНаСкладахОстатки.Склад КАК Склад,
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток,
	|	0 КАК Продажи
	|ПОМЕСТИТЬ ВТ_ДвиженияПлоские
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Склад = &СкладРЦ
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Номенклатура.Номенклатура
	|					ИЗ
	|						ВТ_Номенклатура)) КАК ТоварыНаСкладахОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыМагазинов.Номенклатура,
	|	ЕСТЬNULL(ТоварыМагазинов.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)),
	|	ТоварыМагазинов.Склад,
	|	ТоварыМагазинов.ВНаличииОстаток,
	|	0
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Склад В
	|					(ВЫБРАТЬ
	|						ВТ_РозничныеСклады.Склад
	|					ИЗ
	|						ВТ_РозничныеСклады)
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Номенклатура.Номенклатура
	|					ИЗ
	|						ВТ_Номенклатура)) КАК ТоварыМагазинов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВыручкаОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
	|	ЕСТЬNULL(ВыручкаОбороты.АналитикаУчетаНоменклатуры.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)),
	|	ВыручкаОбороты.Склад,
	|	0,
	|	ВыручкаОбороты.КоличествоОборот
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			&ДатаНачалаПериода,
	|			&ДатаОкончанияПериода,
	|			Авто,
	|			Склад В
	|					(ВЫБРАТЬ
	|						ВТ_РозничныеСклады.Склад
	|					ИЗ
	|						ВТ_РозничныеСклады)
	|				И АналитикаУчетаНоменклатуры.Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Номенклатура.Номенклатура
	|					ИЗ
	|						ВТ_Номенклатура)) КАК ВыручкаОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Склад";
	
	Запрос.Выполнить();  
	
    СтруктураВозврата = Новый Структура;

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВТ_РозничныеСклады.Склад КАК Справочник.Склады) КАК Склад,
	|	ВТ_РозничныеСклады.Наименование КАК Наименование
	|ИЗ
	|	ВТ_РозничныеСклады КАК ВТ_РозничныеСклады";

	СтруктураВозврата.Вставить("ТаблицаМатрицы", Запрос.Выполнить().Выгрузить());

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ДвиженияХарактеристики.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВТ_Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Номенклатура.ЭтоШтучныйТовар КАК ЭтоШтучныйТовар
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДвиженияПлоские КАК ДвиженияХарактеристики
	|		ПО ВТ_Номенклатура.Номенклатура = ДвиженияХарактеристики.Номенклатура";

	СтруктураВозврата.Вставить("КаркасТоваров", Запрос.Выполнить().Выгрузить());

		Запрос.УстановитьПараметр("СкладРЦ", ПараметрыЗапроса.СкладРЦ);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Движения.Номенклатура КАК Номенклатура,
	|	Движения.Характеристика КАК Характеристика,
	|	ВЫРАЗИТЬ(Движения.Склад КАК Справочник.Склады) КАК Склад,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.Склад = &СкладРЦ
	|				ТОГДА Движения.Остаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОстатокРЦ,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.Склад <> &СкладРЦ
	|				ТОГДА Движения.Остаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОстатокМагазина,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.Склад <> &СкладРЦ
	|				ТОГДА Движения.Продажи
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПродажиМагазина
	|ИЗ
	|	ВТ_ДвиженияПлоские КАК Движения
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Номенклатура,
	|	Движения.Характеристика,
	|	Движения.Склад";

	СтруктураВозврата.Вставить("ТаблицаВсехГМ", Запрос.Выполнить().Выгрузить());

	Возврат СтруктураВозврата;
